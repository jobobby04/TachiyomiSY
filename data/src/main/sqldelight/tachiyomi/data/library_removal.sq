-- SY-specific file

CREATE TABLE library_removal (
    manga_id INTEGER NOT NULL PRIMARY KEY,
    removed_at INTEGER NOT NULL,
    FOREIGN KEY(manga_id) REFERENCES manga (id)
    ON DELETE CASCADE
);

CREATE TRIGGER record_library_removal
AFTER UPDATE OF user_favorite_at ON manga
WHEN new.state_is_syncing = 0 AND old.user_favorite_at IS NOT NULL AND new.user_favorite_at IS NULL
BEGIN
    INSERT OR REPLACE INTO library_removal (manga_id, removed_at) VALUES (new.id, strftime('%s', 'now'));
END;

CREATE TRIGGER clear_library_removal
AFTER UPDATE OF user_favorite_at ON manga
WHEN new.user_favorite_at IS NOT NULL
BEGIN
    DELETE FROM library_removal WHERE manga_id = new.id;
END;
