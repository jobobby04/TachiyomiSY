-- SY-specific file
import kotlin.Boolean;

-- One row per merged entry. Merge-level settings live here.
CREATE TABLE merge(
    manga_id INTEGER NOT NULL PRIMARY KEY,
    chapter_sort_mode INTEGER NOT NULL DEFAULT 0,
    info_manga_id INTEGER,
    FOREIGN KEY(manga_id) REFERENCES manga (id)
    ON DELETE CASCADE,
    FOREIGN KEY(info_manga_id) REFERENCES manga (id)
    ON DELETE SET NULL
);

-- One row per underlying entry in a merge. Per-entry settings live here.
CREATE TABLE merged_entry(
    _id INTEGER NOT NULL PRIMARY KEY,
    merge_id INTEGER NOT NULL,
    manga_id INTEGER NOT NULL,
    fetch_chapter_updates INTEGER AS Boolean NOT NULL DEFAULT 1,
    download_chapters INTEGER AS Boolean NOT NULL DEFAULT 1,
    chapter_priority INTEGER NOT NULL DEFAULT 0,
    UNIQUE(merge_id, manga_id),
    FOREIGN KEY(merge_id) REFERENCES merge (manga_id)
    ON DELETE CASCADE,
    FOREIGN KEY(manga_id) REFERENCES manga (id)
    ON DELETE CASCADE
);

CREATE INDEX merged_entry_merge_id_index ON merged_entry(merge_id);

selectMerge:
SELECT manga_id, chapter_sort_mode, info_manga_id
FROM merge
WHERE manga_id = :mangaId;

insertMerge:
INSERT INTO merge(manga_id, chapter_sort_mode, info_manga_id)
VALUES (:mangaId, :chapterSortMode, :infoMangaId)
ON CONFLICT(manga_id) DO UPDATE SET
    chapter_sort_mode = excluded.chapter_sort_mode,
    info_manga_id = excluded.info_manga_id;

updateMerge:
UPDATE merge SET
    chapter_sort_mode = :chapterSortMode,
    info_manga_id = :infoMangaId
WHERE manga_id = :mangaId;

selectEntriesByMergeId:
SELECT
    _id, merge_id, manga_id, fetch_chapter_updates, download_chapters, chapter_priority
FROM merged_entry
WHERE merge_id = :mergeId;

selectAllEntries:
SELECT
    _id, merge_id, manga_id, fetch_chapter_updates, download_chapters, chapter_priority
FROM merged_entry;

insertEntry:
INSERT INTO merged_entry(
    merge_id, manga_id, fetch_chapter_updates, download_chapters, chapter_priority
)
VALUES (
    :mergeId, :mangaId, :fetchChapterUpdates, :downloadChapters, :chapterPriority
);

insertEntryReturningId:
INSERT INTO merged_entry(
    merge_id, manga_id, fetch_chapter_updates, download_chapters, chapter_priority
)
VALUES (
    :mergeId, :mangaId, :fetchChapterUpdates, :downloadChapters, :chapterPriority
)
RETURNING _id;

updateEntry:
UPDATE merged_entry SET
    fetch_chapter_updates = :fetchChapterUpdates,
    download_chapters = :downloadChapters,
    chapter_priority = :chapterPriority
WHERE _id = :id;

deleteEntryById:
DELETE FROM merged_entry
WHERE _id = :id;

deleteEntriesByMergeId:
DELETE FROM merged_entry
WHERE merge_id = :mergeId;

selectMergedMangasById:
SELECT
    manga.id, manga.source_id, manga.remote_url, manga.remote_title, manga.remote_author,
    manga.remote_artist, manga.remote_description, manga.remote_genre, manga.remote_status,
    manga.remote_cover, manga.remote_update_strategy, manga.remote_memo, manga.user_favorite_at,
    manga.user_notes, manga.user_reader_flags, manga.user_chapter_flags,
    manga.state_chapter_last_update, manga.state_chapter_next_update,
    manga.state_chapter_fetch_interval, manga.state_cover_last_modified, manga.state_initialized,
    manga.state_last_modified_at, manga.state_version, manga.state_is_syncing,
    manga.user_title, manga.user_author, manga.user_artist, manga.user_thumbnail_url,
    manga.user_description, manga.user_genre, manga.user_status
FROM (
    SELECT manga_id FROM merged_entry WHERE merge_id = :mergeId
) AS M
JOIN manga
ON manga.id = M.manga_id;

selectMergedMangasForDownloadingById:
SELECT
    manga.id, manga.source_id, manga.remote_url, manga.remote_title, manga.remote_author,
    manga.remote_artist, manga.remote_description, manga.remote_genre, manga.remote_status,
    manga.remote_cover, manga.remote_update_strategy, manga.remote_memo, manga.user_favorite_at,
    manga.user_notes, manga.user_reader_flags, manga.user_chapter_flags,
    manga.state_chapter_last_update, manga.state_chapter_next_update,
    manga.state_chapter_fetch_interval, manga.state_cover_last_modified, manga.state_initialized,
    manga.state_last_modified_at, manga.state_version, manga.state_is_syncing,
    manga.user_title, manga.user_author, manga.user_artist, manga.user_thumbnail_url,
    manga.user_description, manga.user_genre, manga.user_status
FROM (
    SELECT manga_id FROM merged_entry WHERE merge_id = :mergeId AND download_chapters = 1
) AS M
JOIN manga
ON manga.id = M.manga_id;

selectAllMergedMangas:
SELECT
    manga.id, manga.source_id, manga.remote_url, manga.remote_title, manga.remote_author,
    manga.remote_artist, manga.remote_description, manga.remote_genre, manga.remote_status,
    manga.remote_cover, manga.remote_update_strategy, manga.remote_memo, manga.user_favorite_at,
    manga.user_notes, manga.user_reader_flags, manga.user_chapter_flags,
    manga.state_chapter_last_update, manga.state_chapter_next_update,
    manga.state_chapter_fetch_interval, manga.state_cover_last_modified, manga.state_initialized,
    manga.state_last_modified_at, manga.state_version, manga.state_is_syncing,
    manga.user_title, manga.user_author, manga.user_artist, manga.user_thumbnail_url,
    manga.user_description, manga.user_genre, manga.user_status
FROM (
    SELECT manga_id FROM merged_entry
) AS M
JOIN manga
ON manga.id = M.manga_id;
